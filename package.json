{
  "name": "chrae-lab",
  "private": true,
  "version": "0.0.0",
  "description": "Chrae Lab: a FIRE planner, browser games and small tools that run entirely in your browser.",
  "homepage": "https://fire.chraegames.cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/chraegames/chrae-lab.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "SITE=fire vite",
    "dev:fire": "SITE=fire vite",
    "dev:games": "SITE=games vite",
    "dev:tools": "SITE=tools vite",
    "build": "tsc -b && npm run build:sites",
    "build:sites": "rm -rf dist && SITE=fire vite build && SITE=games vite build && SITE=tools vite build && rm -rf dist/legacy && mkdir -p dist/legacy && cp legacy/migrate.html dist/legacy/ && tsx scripts/legacy-robots.ts",
    "lint": "eslint .",
    "preview": "SITE=fire vite preview",
    "preview:games": "SITE=games vite preview",
    "preview:tools": "SITE=tools vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mt:validate": "npx tsx scripts/mt-validate.ts",
    "city:sim": "npx tsx scripts/city-sim.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "three": "^0.185.1",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.4"
  }
}
